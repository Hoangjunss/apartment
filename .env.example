# ==============================================================================
# APARTMENT SERVICE SYSTEM - ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to '.env' at the root for local development.
# Do NOT commit the actual '.env' file to Git!

# ─── DATABASE CONFIGURATION (Prisma & DB Service) ─────────────────────────────
# Local development database URL
DATABASE_URL="mysql://root:root_password@localhost:3306/qlchdv"

# ─── BACKEND SERVER CONFIGURATION ──────────────────────────────────────────────
PORT=3001
FRONTEND_URL="http://localhost:5173"
TZ="Asia/Ho_Chi_Minh"

# JWT Auth secrets (generate strong secrets for production)
JWT_SECRET="generate_a_secure_random_key_here"
JWT_REFRESH_SECRET="generate_another_secure_random_key_here"

# ─── CLOUDINARY CONFIGURATION (Attachments & Images Upload) ────────────────────
CLOUDINARY_CLOUD_NAME="your_cloudinary_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
CLOUDINARY_FOLDER="qlchdv_dev"

# ─── FRONTEND CONFIGURATION (Vite Env Variables) ────────────────────────────────
VITE_API_URL="https://api.qlchdv.yourdomain.com/api"
VITE_SOCKET_URL="https://api.qlchdv.yourdomain.com"
