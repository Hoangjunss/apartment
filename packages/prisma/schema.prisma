generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── AUTH ────────────────────────────────────────────────

enum UserRole {
  ADMIN
  MANAGER
  TECHNICIAN
  RECEPTIONIST
}

model Users {
  id            Int       @id @default(autoincrement())
  email         String    @unique @db.VarChar(255)
  password_hash String    @db.VarChar(255)
  full_name     String    @db.VarChar(100)
  phone         String?   @db.VarChar(20)
  role          UserRole
  is_active     Boolean   @default(true)
  last_login_at DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  // Relations
  created_contracts   Contracts[]              @relation("ContractCreator")
  status_logs         ApartmentStatusLogs[]
  utility_recordings  UtilityReadings[]
  invoice_creations   Invoices[]
  payment_records     Payments[]
  service_assignments ServiceRequests[]        @relation("AssignedTo")
  contract_renewals   ContractRenewals[]
  temp_registrations  TemporaryRegistrations[]
  comments            ServiceRequestComments[] @relation("UserComments")
  attachments         Attachments[]            @relation("UserAttachments")
  credit_transactions CreditTransactions[]     @relation("CreditTxRecorder")
  expense_creations   BuildingExpenses[]       @relation("ExpenseCreator")
  building_assignments BuildingAssignments[]    @relation("UserAssignments")
  assigned_others      BuildingAssignments[]    @relation("AssignerAssignments")
}

// ─── BUILDING & APARTMENT ────────────────────────────────

model Buildings {
  id           Int       @id @default(autoincrement())
  code         String    @unique @db.VarChar(20)
  name         String    @db.VarChar(100)
  address      String    @db.Text
  total_floors Int
  description  String?   @db.Text
  created_at   DateTime  @default(now())
  deleted_at   DateTime?

  floors Floors[]
  expenses BuildingExpenses[]
  assignments BuildingAssignments[]
}

model Floors {
  id           Int     @id @default(autoincrement())
  building_id  Int
  floor_number Int
  description  String? @db.VarChar(255)

  building   Buildings    @relation(fields: [building_id], references: [id])
  apartments Apartments[]

  @@index([building_id])
}

enum ApartmentStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  RESERVED
}

enum RoomType {
  STUDIO
  ONE_BR
  TWO_BR
  THREE_BR
}

model Apartments {
  id             Int             @id @default(autoincrement())
  floor_id       Int
  apartment_code String          @unique @db.VarChar(20)
  room_type      RoomType
  area_sqm       Decimal         @db.Decimal(6, 2)
  max_occupants  Int
  base_price     Decimal         @db.Decimal(15, 2)
  deposit_amount Decimal         @db.Decimal(15, 2)
  status         ApartmentStatus @default(AVAILABLE)
  description    String?         @db.Text
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt
  deleted_at     DateTime?

  floor              Floors                   @relation(fields: [floor_id], references: [id])
  furniture          ApartmentFurniture[]
  status_logs        ApartmentStatusLogs[]
  contracts          Contracts[]
  utility_readings   UtilityReadings[]
  invoices           Invoices[]
  temp_registrations TemporaryRegistrations[]
  service_requests   ServiceRequests[]
  tokens             ApartmentTokens?

  @@index([floor_id])
  @@index([status])
}

enum FurnitureCondition {
  NEW
  GOOD
  WORN
}

model ApartmentFurniture {
  id           Int                @id @default(autoincrement())
  apartment_id Int
  item_name    String             @db.VarChar(100)
  quantity     Int
  condition    FurnitureCondition
  note         String?            @db.Text
  created_at   DateTime           @default(now())

  apartment Apartments @relation(fields: [apartment_id], references: [id])

  @@index([apartment_id])
}

model ApartmentStatusLogs {
  id           Int             @id @default(autoincrement())
  apartment_id Int
  old_status   ApartmentStatus
  new_status   ApartmentStatus
  changed_by   Int
  reason       String?         @db.Text
  changed_at   DateTime        @default(now())

  apartment Apartments @relation(fields: [apartment_id], references: [id])
  user      Users      @relation(fields: [changed_by], references: [id])

  @@index([apartment_id])
}

// ─── TENANT & CONTRACT ───────────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Tenants {
  id                       Int       @id @default(autoincrement())
  full_name                String    @db.VarChar(100)
  national_id              String    @unique @db.VarChar(20)
  national_id_issued_date  DateTime  @db.Date
  national_id_issued_place String    @db.VarChar(255)
  date_of_birth            DateTime  @db.Date
  gender                   Gender
  phone                    String    @db.VarChar(20)
  email                    String?   @db.VarChar(255)
  permanent_address        String    @db.Text
  nationality              String    @default("Việt Nam") @db.VarChar(100)
  occupation               String?   @db.VarChar(100)
  avatar_url               String?   @db.VarChar(512)
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt
  deleted_at               DateTime?

  contracts               Contracts[]
  temporary_registrations TemporaryRegistrations[]

  @@index([national_id])
  @@index([phone])
}

enum ContractStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  TERMINATED
}

model Contracts {
  id                 Int            @id @default(autoincrement())
  contract_code      String         @unique @db.VarChar(30)
  tenant_id          Int
  apartment_id       Int
  start_date         DateTime       @db.Date
  end_date           DateTime       @db.Date
  monthly_rent       Decimal        @db.Decimal(15, 2)
  deposit_amount     Decimal        @db.Decimal(15, 2)
  payment_due_day    Int
  status             ContractStatus @default(ACTIVE)
  termination_reason String?        @db.Text
  notes              String?        @db.Text
  created_by         Int
  created_at         DateTime       @default(now())
  updated_at         DateTime       @updatedAt
  deleted_at         DateTime?

  // Real-world fields
  occupants_count          Int            @default(1)
  soNguoiO                 Int            @default(1)
  water_price_per_month    Decimal        @default(100000) @db.Decimal(15, 2)
  initial_electricity      Decimal        @default(0) @db.Decimal(10, 2)
  electricity_price        Decimal        @default(3500) @db.Decimal(10, 2)
  initial_water            Decimal?       @db.Decimal(10, 2)
  furniture_handover       String?        @db.Text
  termination_notice_days  Int            @default(30)

  tenant    Tenants    @relation(fields: [tenant_id], references: [id])
  apartment Apartments @relation(fields: [apartment_id], references: [id])
  creator   Users      @relation("ContractCreator", fields: [created_by], references: [id])

  renewals              ContractRenewals[]
  service_subscriptions ServiceSubscriptions[]
  invoices              Invoices[]
  service_requests      ServiceRequests[]
  credit                ContractCredits?
  credit_transactions   CreditTransactions[]

  @@index([tenant_id])
  @@index([apartment_id])
  @@index([status])
  @@index([end_date])
  @@index([status, end_date])
  @@index([apartment_id, status])
  @@index([tenant_id, status])
}

model ContractRenewals {
  id               Int      @id @default(autoincrement())
  contract_id      Int
  old_end_date     DateTime @db.Date
  new_end_date     DateTime @db.Date
  new_monthly_rent Decimal  @db.Decimal(15, 2)
  notes            String?  @db.Text
  renewed_by       Int
  created_at       DateTime @default(now())

  contract Contracts @relation(fields: [contract_id], references: [id])
  user     Users     @relation(fields: [renewed_by], references: [id])

  @@index([contract_id])
}

enum RegistrationType {
  TEMPORARY_RESIDENCE
  TEMPORARY_ABSENCE
}

model TemporaryRegistrations {
  id           Int              @id @default(autoincrement())
  tenant_id    Int
  apartment_id Int
  type         RegistrationType
  start_date   DateTime         @db.Date
  end_date     DateTime         @db.Date
  destination  String?          @db.VarChar(255)
  reason       String?          @db.Text
  submitted_by Int
  created_at   DateTime         @default(now())

  tenant    Tenants    @relation(fields: [tenant_id], references: [id])
  apartment Apartments @relation(fields: [apartment_id], references: [id])
  submitter Users      @relation(fields: [submitted_by], references: [id])

  @@index([tenant_id])
  @@index([apartment_id])
}

// ─── SERVICE & FINANCE ───────────────────────────────────

enum ServiceType {
  CLEANING
  LAUNDRY
  INTERNET
  CABLE_TV
  OTHER
}

model Services {
  id          Int         @id @default(autoincrement())
  name        String      @db.VarChar(100)
  type        ServiceType
  unit_price  Decimal     @db.Decimal(15, 2)
  unit        String      @db.VarChar(30)
  description String?     @db.Text
  is_active   Boolean     @default(true)

  subscriptions ServiceSubscriptions[]
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
}

model ServiceSubscriptions {
  id            Int                @id @default(autoincrement())
  contract_id   Int
  service_id    Int
  status        SubscriptionStatus @default(ACTIVE)
  quantity      Int                @default(1)
  note          String?            @db.Text
  subscribed_at DateTime           @default(now())

  contract Contracts @relation(fields: [contract_id], references: [id])
  service  Services  @relation(fields: [service_id], references: [id])

  @@index([contract_id])
}

model UtilityReadings {
  id                     Int      @id @default(autoincrement())
  apartment_id           Int
  billing_month          String   @db.VarChar(7) // YYYY-MM
  electricity_prev       Decimal  @db.Decimal(10, 2)
  electricity_curr       Decimal  @db.Decimal(10, 2)
  water_prev             Decimal? @db.Decimal(10, 2)
  water_curr             Decimal? @db.Decimal(10, 2)
  electricity_unit_price Decimal  @db.Decimal(10, 2)
  water_unit_price       Decimal? @db.Decimal(10, 2)
  soNguoiO               Int      @default(1)
  recorded_by            Int
  recorded_at            DateTime @default(now())

  apartment Apartments @relation(fields: [apartment_id], references: [id])
  recorder  Users      @relation(fields: [recorded_by], references: [id])

  @@unique([apartment_id, billing_month])
  @@index([apartment_id])
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
}

model Invoices {
  id                 Int           @id @default(autoincrement())
  invoice_code       String        @unique @db.VarChar(30)
  contract_id        Int
  apartment_id       Int
  billing_month      String        @db.VarChar(7)
  rent_amount        Decimal       @db.Decimal(15, 2)
  electricity_amount Decimal       @db.Decimal(15, 2)
  water_amount       Decimal       @db.Decimal(15, 2)
  service_amount     Decimal       @db.Decimal(15, 2)
  other_amount       Decimal       @default(0) @db.Decimal(15, 2)
  credit_applied     Decimal       @default(0.00) @db.Decimal(15, 2)
  debt_amount        Decimal       @default(0.00) @db.Decimal(15, 2)
  total_amount       Decimal       @db.Decimal(15, 2)
  status             InvoiceStatus @default(UNPAID)
  due_date           DateTime      @db.Date
  note               String?       @db.Text
  created_by         Int
  created_at         DateTime      @default(now())
  deleted_at         DateTime?

  contract            Contracts            @relation(fields: [contract_id], references: [id])
  apartment           Apartments           @relation(fields: [apartment_id], references: [id])
  creator             Users                @relation(fields: [created_by], references: [id])
  payments            Payments[]
  credit_transactions CreditTransactions[]

  @@unique([contract_id, billing_month])
  @@index([status])
  @@index([due_date])
  @@index([status, due_date])
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

model Payments {
  id               Int           @id @default(autoincrement())
  invoice_id       Int
  amount           Decimal       @db.Decimal(15, 2)
  payment_method   PaymentMethod
  payment_date     DateTime      @db.Date
  reference_number String?       @db.VarChar(100)
  note             String?       @db.Text
  recorded_by      Int
  created_at       DateTime      @default(now())

  invoice             Invoices             @relation(fields: [invoice_id], references: [id])
  recorder            Users                @relation(fields: [recorded_by], references: [id])
  credit_transactions CreditTransactions[]

  @@index([invoice_id])
}

enum ServiceRequestType {
  MAINTENANCE
  CLEANING
  COMPLAINT
  OTHER
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ServiceRequestStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CANCELLED
  POSTPONED
}

enum RequestSource {
  INTERNAL
  PUBLIC_FORM
}

model ServiceRequests {
  id              Int                  @id @default(autoincrement())
  apartment_id    Int
  contract_id     Int?
  title           String               @db.VarChar(200)
  description     String               @db.Text
  type            ServiceRequestType   @default(MAINTENANCE)
  priority        Priority             @default(NORMAL)
  status          ServiceRequestStatus @default(PENDING)
  source          RequestSource        @default(INTERNAL)
  requester_name  String?              @db.VarChar(100)
  requester_phone String?              @db.VarChar(20)
  assigned_to     Int?
  resolved_at     DateTime?
  scheduled_start_date DateTime?             @db.Date
  created_at      DateTime             @default(now())
  updated_at      DateTime             @updatedAt

  apartment Apartments @relation(fields: [apartment_id], references: [id])
  contract  Contracts? @relation(fields: [contract_id], references: [id])
  assignee  Users?     @relation("AssignedTo", fields: [assigned_to], references: [id])
  comments  ServiceRequestComments[]
  expenses  ServiceRequestExpenses[]

  @@index([apartment_id])
  @@index([contract_id])
  @@index([assigned_to])
  @@index([status])
}

model ApartmentTokens {
  id           Int        @id @default(autoincrement())
  apartment_id Int        @unique
  token        String     @unique @db.VarChar(16)
  expires_at   DateTime
  created_at   DateTime   @default(now())

  apartment Apartments @relation(fields: [apartment_id], references: [id])

  @@index([apartment_id])
}

// ─── AUDIT LOG ────────────────────────────────────────────

model AuditLogs {
  id            Int      @id @default(autoincrement())
  actor_id      Int
  actor_name    String   @db.VarChar(100)
  action        String   @db.VarChar(50)   // CREATE, UPDATE, DELETE
  resource_type String   @db.VarChar(50)   // Contract, Tenant, Invoice...
  resource_id   Int?
  old_data      Json?
  new_data      Json?
  ip_address    String?  @db.VarChar(45)
  created_at    DateTime @default(now())

  @@index([actor_id])
  @@index([resource_type, resource_id])
  @@index([created_at])
}

// ─── NOTIFICATIONS ────────────────────────────────────────

model Notifications {
  id         Int      @id @default(autoincrement())
  user_id    Int
  title      String   @db.VarChar(200)
  message    String   @db.Text
  type       String   @db.VarChar(50)   // CONTRACT_EXPIRING, INVOICE_OVERDUE, MAINTENANCE_ASSIGNED, PAYMENT_RECEIVED
  entity_type String? @db.VarChar(50)   // Contract, Invoice... (extensible)
  entity_id   Int?                      // FK to the related entity (extensible)
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([user_id, is_read])
  @@index([created_at])
}

// ─── COMMENTS ─────────────────────────────────────────────

model ServiceRequestComments {
  id                 Int      @id @default(autoincrement())
  service_request_id Int
  content            String   @db.Text
  created_by         Int
  created_at         DateTime @default(now())

  service_request ServiceRequests @relation(fields: [service_request_id], references: [id], onDelete: Cascade)
  creator         Users           @relation("UserComments", fields: [created_by], references: [id])

  @@index([service_request_id])
}

// ─── ATTACHMENTS ──────────────────────────────────────────

model Attachments {
  id          Int      @id @default(autoincrement())
  file_name   String   @db.VarChar(255)
  file_url    String   @db.VarChar(512)
  file_size   Int
  mime_type   String   @db.VarChar(100)
  entity_type String   @db.VarChar(50)   // e.g. ServiceRequest, Contract, Invoice, Tenant
  entity_id   Int
  uploaded_by Int
  created_at  DateTime @default(now())

  uploader    Users    @relation("UserAttachments", fields: [uploaded_by], references: [id])

  @@index([entity_type, entity_id])
}

// ─── EXPENSES ─────────────────────────────────────────────

model ServiceRequestExpenses {
  id                 Int             @id @default(autoincrement())
  service_request_id Int
  description        String          @db.VarChar(255)
  amount             Decimal         @db.Decimal(15, 2)
  created_at         DateTime        @default(now())

  service_request    ServiceRequests @relation(fields: [service_request_id], references: [id], onDelete: Cascade)

  @@index([service_request_id])
}

// ─── CONTRACT CREDITS & TRANSACTIONS ──────────────────────

enum CreditTxType {
  CREDIT_IN
  CREDIT_APPLY
  CREDIT_REFUND
}

model ContractCredits {
  id          Int      @id @default(autoincrement())
  contract_id Int      @unique
  balance     Decimal  @db.Decimal(15, 2) @default(0.00)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  contract Contracts @relation(fields: [contract_id], references: [id], onDelete: Cascade)
}

model CreditTransactions {
  id          Int          @id @default(autoincrement())
  contract_id Int
  invoice_id  Int?
  payment_id  Int?
  type        CreditTxType
  amount      Decimal      @db.Decimal(15, 2)
  description String?      @db.Text
  recorded_by Int
  created_at  DateTime     @default(now())

  contract Contracts @relation(fields: [contract_id], references: [id], onDelete: Cascade)
  invoice  Invoices? @relation(fields: [invoice_id], references: [id], onDelete: SetNull)
  payment  Payments? @relation(fields: [payment_id], references: [id], onDelete: SetNull)
  recorder Users     @relation("CreditTxRecorder", fields: [recorded_by], references: [id])

  @@index([contract_id])
  @@index([invoice_id])
  @@index([payment_id])
}

// ─── BUILDING EXPENSES ────────────────────────────────────

enum ExpenseCategory {
  OPERATIONS
  MAINTENANCE
}

enum ExpenseStatus {
  PENDING
  PAID
}

model BuildingExpenses {
  id           Int             @id @default(autoincrement())
  building_id  Int
  category     ExpenseCategory
  title        String          @db.VarChar(200)
  amount       Decimal         @db.Decimal(15, 2)
  expense_date DateTime        @db.Date
  status       ExpenseStatus   @default(PENDING)
  description  String?         @db.Text
  created_by   Int
  created_at   DateTime        @default(now())
  updated_at   DateTime        @updatedAt
  deleted_at   DateTime?

  building   Buildings @relation(fields: [building_id], references: [id], onDelete: Cascade)
  creator    Users     @relation("ExpenseCreator", fields: [created_by], references: [id])

  @@index([building_id])
  @@index([status])
  @@index([expense_date])
}

// ─── SENIOR LEVEL WORKFLOW, RULES & POLICIES ──────────────

model Workflows {
  id          Int                  @id @default(autoincrement())
  name        String               @unique @db.VarChar(100)
  description String?              @db.Text
  created_at  DateTime             @default(now())
  updated_at  DateTime             @updatedAt

  steps       WorkflowSteps[]
  transitions WorkflowTransitions[]
}

model WorkflowSteps {
  id           Int      @id @default(autoincrement())
  workflow_id  Int
  step_name    String   @db.VarChar(50)
  order_number Int
  is_initial   Boolean  @default(false)
  is_final     Boolean  @default(false)

  workflow     Workflows @relation(fields: [workflow_id], references: [id], onDelete: Cascade)
  
  transitions_from WorkflowTransitions[] @relation("FromStep")
  transitions_to   WorkflowTransitions[] @relation("ToStep")

  @@unique([workflow_id, step_name])
}

model WorkflowTransitions {
  id           Int      @id @default(autoincrement())
  workflow_id  Int
  from_step_id Int
  to_step_id   Int
  name         String?  @db.VarChar(100)
  role_allowed String?  @db.VarChar(100)

  workflow     Workflows     @relation(fields: [workflow_id], references: [id], onDelete: Cascade)
  from_step    WorkflowSteps @relation("FromStep", fields: [from_step_id], references: [id], onDelete: Cascade)
  to_step      WorkflowSteps @relation("ToStep", fields: [to_step_id], references: [id], onDelete: Cascade)

  @@index([workflow_id])
}

model BusinessRules {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  entity      String   @db.VarChar(50)
  condition   Json
  action      String   @db.VarChar(50)
  action_data Json?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

model BuildingAssignments {
  id          Int       @id @default(autoincrement())
  user_id     Int
  building_id Int
  assigned_at DateTime  @default(now())
  assigned_by Int
  revoked_at  DateTime?

  user        Users     @relation("UserAssignments", fields: [user_id], references: [id], onDelete: Cascade)
  building    Buildings @relation(fields: [building_id], references: [id], onDelete: Cascade)
  assigner    Users     @relation("AssignerAssignments", fields: [assigned_by], references: [id])

  @@unique([user_id, building_id])
  @@index([user_id])
  @@index([building_id])
}

model Timeline {
  id            Int      @id @default(autoincrement())
  entity_type   String   @db.VarChar(50)
  entity_id     Int
  title         String   @db.VarChar(200)
  description   String?  @db.Text
  actor_id      Int?
  actor_name    String?  @db.VarChar(100)
  created_at    DateTime @default(now())

  @@index([entity_type, entity_id])
}

